{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2020"],
    "types": []
  },
  "include": ["main.ts", "constants.ts", "i18n.ts"]
}
